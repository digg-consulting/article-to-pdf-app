{
  "manifest_version": 3,
  "name": "Article to PDF",
  "version": "2.0.0",
  "description": "Save the current article as a clean PDF using a local native helper.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["activeTab", "tabs", "downloads", "nativeMessaging", "contextMenus"],
  "browser_specific_settings": {
    "gecko": {
      "id": "article-to-pdf@local",
      "strict_min_version": "128.0"
    }
  }
}
