{
  "manifest_version": 3,
  "name": "Article to PDF",
  "version": "4.0.0",
  "description": "Save any web article as a clean PDF via Playwright — article only, with your browser session.",
  "key": "",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "cookies",
    "downloads",
    "nativeMessaging",
    "contextMenus"
  ],
  "host_permissions": ["https://*/*", "http://*/*"]
}
